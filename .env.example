# Copy to .env.local. Only PUBLIC values belong here — never the Supabase secret/service key,
# database URL, Stripe secret key or AI keys (those live in the backend's .env).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# The "publishable" key (sb_publishable_…) or legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional
NEXT_PUBLIC_MCP_URL=https://mcp.smartcontent.example/mcp
NEXT_PUBLIC_HELP_URL=

# Leave the Supabase + API values empty to run the dashboard as a local demo.
